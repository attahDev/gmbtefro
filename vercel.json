{
    "rewrites": [
      {
        "source": "/news/:id",
        "has": [
          {
            "type": "header",
            "key": "user-agent",
            "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|LinkedInBot|TelegramBot|Discordbot|Googlebot|bingbot|Applebot|Pinterest|redditbot|SkypeUriPreview|vkShare|Embedly).*"
          }
        ],
        "destination": "/api/news-meta?id=:id"
      },
      { "source": "/api/(.*)", "destination": "/api/$1" },
      { "source": "/(.*)", "destination": "/" }
    ]
  }
